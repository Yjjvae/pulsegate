---
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -portability-avoid-pragma-once,
  -performance-enum-size
WarningsAsErrors: ''
HeaderFilterRegex: '(^|.*/)(include|src|app|tests)/'
FormatStyle: file
CheckOptions:
  readability-FunctionCognitiveComplexity.Threshold: '25'
  readability-ImplicitBoolConversion.AllowPointerConditions: 'true'
...
